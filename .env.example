# Configuración simbólica de entorno - Libros Impresos S.A. (Caso 18)
# Copie este archivo a .env y reemplace todos los valores CHANGE_ME_* antes de iniciar Docker.
# NUNCA incluya credenciales reales en el repositorio ni en evidencias.

POSTGRES_DB=libros_impresos_db
POSTGRES_USER=libros_app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

JWT_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Tokens de identidad entre componentes internos (red private_net)
INTERNAL_TOKEN_AUTH=CHANGE_ME_INTERNAL_TOKEN_AUTH
INTERNAL_TOKEN_CLIENTS=CHANGE_ME_INTERNAL_TOKEN_CLIENTS
INTERNAL_TOKEN_INVENTORY=CHANGE_ME_INTERNAL_TOKEN_INVENTORY
INTERNAL_TOKEN_ORDERS=CHANGE_ME_INTERNAL_TOKEN_ORDERS
INTERNAL_TOKEN_PAYMENTS=CHANGE_ME_INTERNAL_TOKEN_PAYMENTS
INTERNAL_TOKEN_GRAPHQL=CHANGE_ME_INTERNAL_TOKEN_GRAPHQL

# Gateway y resiliencia
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_API_MAX=600
UPSTREAM_TIMEOUT_MS=4000
APP_TIMEZONE=America/Santiago

# Proveedor externo de correo (modo sandbox verificable)
EMAIL_PROVIDER_MODE=sandbox
EMAIL_API_KEY=CHANGE_ME_SANDBOX_EMAIL_KEY

LOG_LEVEL=info
