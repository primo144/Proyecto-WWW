# Configuración local Entrega 2: Oracle Database Free + ASP.NET Core 10.
# Copia a .env y sustituye cada CHANGE_ME por secretos aleatorios distintos.
# Las contraseñas de los esquemas deben coincidir con db/oracle/01-create-users.sql.

ORACLE_SYSTEM_PASSWORD=CHANGE_ME_Oracle2026!
AUTH_DB_PASSWORD=CHANGE_ME_Auth2026!
CLIENTS_DB_PASSWORD=CHANGE_ME_Clients2026!
INVENTORY_DB_PASSWORD=CHANGE_ME_Inventory2026!
ORDERS_DB_PASSWORD=CHANGE_ME_Orders2026!
PAYMENTS_DB_PASSWORD=CHANGE_ME_Payments2026!

JWT_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_MIN_32_CHARS
INTERNAL_TOKEN_AUTH=CHANGE_ME_INTERNAL_TOKEN_AUTH_MIN_32_CHARS
INTERNAL_TOKEN_CLIENTS=CHANGE_ME_INTERNAL_TOKEN_CLIENTS_MIN_32_CHARS
INTERNAL_TOKEN_INVENTORY=CHANGE_ME_INTERNAL_TOKEN_INVENTORY_MIN_32_CHARS
INTERNAL_TOKEN_ORDERS=CHANGE_ME_INTERNAL_TOKEN_ORDERS_MIN_32_CHARS
INTERNAL_TOKEN_PAYMENTS=CHANGE_ME_INTERNAL_TOKEN_PAYMENTS_MIN_32_CHARS
INTERNAL_TOKEN_GRAPHQL=CHANGE_ME_INTERNAL_TOKEN_GRAPHQL_MIN_32_CHARS

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_API_MAX=600
UPSTREAM_TIMEOUT_MS=4000
APP_TIMEZONE=America/Santiago
WEEKLY_NOTICES_ENABLED=true
WEEKLY_NOTICES_TIME=01:00
EMAIL_PROVIDER_MODE=sandbox
# Al cambiar a EMAIL_PROVIDER_MODE=http, completa las siguientes dos referencias.
EMAIL_API_URL=
EMAIL_API_KEY=
