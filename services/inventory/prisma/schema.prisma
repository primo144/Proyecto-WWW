generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServicioAlimentacion {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo         String               @unique @db.VarChar(40)
  nombre         String               @db.VarChar(100)
  descripcion    String               @db.VarChar(255)
  esBase         Boolean              @default(false) @map("es_base")
  activo         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  horarios       TurnoServicio[]
  valorizaciones ValorizacionPerfil[]

  @@map("servicios_alimentacion")
}

model TurnoServicio {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  servicioId  String               @map("servicio_id") @db.Uuid
  numeroTurno Int                  @map("numero_turno")
  horaInicio  String               @map("hora_inicio") @db.VarChar(5)
  horaFin     String               @map("hora_fin") @db.VarChar(5)
  servicio    ServicioAlimentacion @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@unique([servicioId, numeroTurno])
  @@map("turno_servicios")
}

model ValorizacionPerfil {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  servicioId   String               @map("servicio_id") @db.Uuid
  perfilCodigo String               @map("perfil_codigo") @db.VarChar(40)
  valorClp     Int                  @map("valor_clp")
  vigente      Boolean              @default(true)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  servicio     ServicioAlimentacion @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@unique([servicioId, perfilCodigo])
  @@map("valorizaciones_perfil")
}

model ProductoCasino {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo     String   @unique @db.VarChar(40)
  nombre     String   @db.VarChar(120)
  categoria  String   @db.VarChar(60)
  precioClp  Int      @map("precio_clp")
  disponible Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("productos_casino")
}
