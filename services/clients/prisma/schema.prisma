generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sucursal {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo       String         @unique @db.VarChar(32)
  nombre       String         @db.VarChar(120)
  direccion    String         @db.VarChar(200)
  activa       Boolean        @default(true)
  casinos      Casino[]
  funcionarios Funcionario[]
  turnos       TurnoMensual[]

  @@map("sucursales")
}

model Casino {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo     String   @unique @db.VarChar(32)
  nombre     String   @db.VarChar(120)
  tipo       String   @db.VarChar(32)
  sucursalId String   @map("sucursal_id") @db.Uuid
  activo     Boolean  @default(true)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  @@map("casinos")
}

model PerfilComensal {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo             String        @unique @db.VarChar(40)
  nombre             String        @db.VarChar(80)
  descripcion        String        @db.VarChar(255)
  permiteMultiVale   Boolean       @default(false) @map("permite_multi_vale")
  maxValesPorHorario Int           @default(1) @map("max_vales_por_horario")
  activo             Boolean       @default(true)
  funcionarios       Funcionario[]

  @@map("perfiles_comensal")
}

model Funcionario {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigoFuncionario String         @unique @map("codigo_funcionario") @db.VarChar(32)
  rut               String         @unique @db.VarChar(20)
  nombreCompleto    String         @map("nombre_completo") @db.VarChar(150)
  email             String         @unique @db.VarChar(150)
  rol               String         @db.VarChar(20)
  perfilId          String         @map("perfil_id") @db.Uuid
  sucursalBaseId    String         @map("sucursal_base_id") @db.Uuid
  activo            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  perfil       PerfilComensal @relation(fields: [perfilId], references: [id])
  sucursalBase Sucursal       @relation(fields: [sucursalBaseId], references: [id])
  turnos       TurnoMensual[]

  @@map("funcionarios")
}

model TurnoMensual {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  funcionarioId      String      @map("funcionario_id") @db.Uuid
  anio               Int
  mes                Int
  numeroTurno        Int         @map("numero_turno")
  sucursalAsignadaId String      @map("sucursal_asignada_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  sucursalAsignada Sucursal    @relation(fields: [sucursalAsignadaId], references: [id])

  @@unique([funcionarioId, anio, mes])
  @@map("turnos_mensuales")
}
